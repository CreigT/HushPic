# Public app URL
APP_URL=https://hushpic.com

# Firebase client config (safe to expose to the browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin service account (server-only; NEVER prefix with VITE_)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Stripe server secrets (server-only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Security notes
# 1. Add these values in Vercel Project Settings -> Environment Variables.
# 2. Never commit real secret values.
# 3. Use Stripe test keys in Preview and live keys only in Production.
# 4. Firebase browser keys identify the project; security comes from Firebase Auth, server verification, and locked Firestore rules.
