# HushPic production configuration
# Copy these names into Vercel Project Settings > Environment Variables.

# Public Firebase web configuration (safe to expose to the browser)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""

# Firebase Admin service account values (SERVER ONLY)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Stripe (SERVER ONLY)
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# Canonical production origin, e.g. https://hushpic.com
APP_URL=""
